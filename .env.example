# === Основной провайдер ===
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# === Запасной провайдер (необязательно) ===
# Например Gemini, если OpenRouter упрётся в лимит
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# === Доступ ===
# Простой токен приложения (приложение шлёт в X-App-Token). Пусто = без проверки.
APP_TOKEN=

# === Лимиты на устройство/IP ===
RATE_PER_HOUR=30
RATE_PER_DAY=200

# === Самопинг для Render ===
# Публичный адрес этого сервиса + /health
PING_URL=
PING_INTERVAL=600

# === Системный промпт (необязательно) ===
# SYSTEM_PROMPT=
